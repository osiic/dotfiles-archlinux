{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    },
    "color": {
      "1": "blue",
      "2": "cyan"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#89b4fa",
      "title": "#cba6f7"
    },
    "key": {
      "width": 15
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "╭─ {user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "├─ {#34}󰍹 Hardware{#}"
    },
    {
      "type": "host",
      "key": "│  󰌢 Host"
    },
    {
      "type": "cpu",
      "key": "│  󰍛 CPU",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": "│  󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "│  󰘚 Memory"
    },
    {
      "type": "disk",
      "key": "│  󰋊 Disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "│  󰂀 Battery"
    },
    {
      "type": "custom",
      "format": "├─ {#35}󰣇 System{#}"
    },
    {
      "type": "os",
      "key": "│  󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "│  󰒋 Kernel"
    },
    {
      "type": "wm",
      "key": "│  󱂬 WM"
    },
    {
      "type": "terminal",
      "key": "│  󰞷 Terminal"
    },
    {
      "type": "shell",
      "key": "│  󰆍 Shell"
    },
    {
      "type": "uptime",
      "key": "│  󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "│  󰏖 Packages"
    },
    {
      "type": "colors",
      "key": "╰─ {#35}󰏘 Colors{#}",
      "symbol": "circle"
    }
  ]
}
